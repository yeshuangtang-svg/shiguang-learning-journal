# 可在网页「API 设置」填写以下三个模型配置，也可复制为 .env 后填写。
# 环境变量 / .env 优先于网页保存的配置。使用支持 Chat Completions tools 的模型。
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# 可选：外部应用调用本机 Agent 的访问令牌，与模型 API Key 不同。
# AGENT_API_TOKEN=replace-with-a-long-random-token
AGENT_HOST=127.0.0.1
AGENT_PORT=8787
# 如需局域网访问，必须主动设置 host、至少24字符 token、允许的主机名/IP。
# AGENT_ALLOWED_HOSTS=192.168.1.10
