# Only application source and project documentation belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/source/

# Personal data, local configuration, generated artifacts, and caches.
**/data/
**/backups/
**/build/
**/dist/
**/output/
**/outputs/
**/tmp/
**/.env
**/.env.*
!**/.env.example
**/config.json
**/runtime.json
**/__pycache__/
**/*.py[cod]
**/*.sqlite*
**/*.db
**/*.db-*
**/*.log
**/*.exe
**/*.zip
**/*.pdf
**/.venv/
**/node_modules/

# Test files are source; temporary test directories are not.
/source/tests/*/
